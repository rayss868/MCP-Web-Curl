# Set the endpoint, API key, and model for your external web fetch service.
EXTERNAL_API_URL=https://api.example.com/v1/web/fetch
EXTERNAL_API_KEY=your-api-key-here
EXTERNAL_API_MODEL=exa

# Search backend: 'google' (default) or 'external'.
# external -> the SEARCH_* endpoint below is tried first and Google Custom
# Search becomes the automatic fallback (and vice versa when primary fails).
SEARCH_PROVIDER=external
SEARCH_BASE_URL=https://api.example.com/v1/web/fetch
SEARCH_MODEL=search-combo
SEARCH_API_KEY=your-search-api-key-here

# Google Custom Search (primary when SEARCH_PROVIDER=google, fallback otherwise)
APIKEY_GOOGLE_SEARCH=your-google-api-key-here
CX_GOOGLE_SEARCH=your-search-engine-id
